{
  "name": "unio-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "dev:memory": "node --env-file-if-exists=.env scripts/dev-memory.js",
    "create-reviewer": "node --env-file-if-exists=.env scripts/create-reviewer.js",
    "migrate:categories": "node --env-file-if-exists=.env scripts/migrate-campaign-categories.js",
    "grandfather-brands": "node --env-file-if-exists=.env scripts/grandfather-brands.js",
    "sync-indexes": "node --env-file-if-exists=.env scripts/sync-indexes.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@azure/storage-blob": "^12.34.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
