PORT=5000
NODE_ENV=development
# Local/Atlas: mongodb+srv://<username>:<password>@<cluster-host>/unio?retryWrites=true&w=majority
# Azure Cosmos DB for MongoDB vCore: use the full string from the Azure teammate (needs retrywrites=false)
MONGODB_URI=
# Comma-separated. On Azure: the App Service URL (plus http://localhost:5173 for local dev)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the site, used to build links (agency approval links). Defaults to the first CLIENT_ORIGIN.
PUBLIC_SITE_URL=
# Production only: proxies in front of the app (Azure App Service = 1)
TRUST_PROXY=1
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=unio_session

# Password given to every seeded demo account (local/hackathon use only)
SEED_DEMO_PASSWORD=
# Password for `npm run create-reviewer -- <email>` (verification reviewers)
REVIEWER_PASSWORD=

# AI Brief Builder (optional). Without a key, the builder returns a labelled template draft.
# Server-side only: never put this in a VITE_* variable.
ANTHROPIC_API_KEY=
BRIEF_AI_MODEL=claude-opus-5-5
# Alternative: Azure OpenAI / Foundry. Endpoint looks like https://<resource>.openai.azure.com/openai/v1; the deployment is the name you gave the model.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Alternative: OpenAI key (sk-..., from platform.openai.com). Used when ANTHROPIC_API_KEY is empty and OPENAI_MODEL is set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Alternative: Google Gemini key (AIza..., from aistudio.google.com). Used when ANTHROPIC_API_KEY and OPENAI_API_KEY are empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternative: DeepSeek key (sk-...). Used when ANTHROPIC_API_KEY and GEMINI_API_KEY are empty.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Alternative: OpenRouter key (sk-or-...). Used only when ANTHROPIC_API_KEY and DEEPSEEK_API_KEY are empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Azure Blob Storage for uploads (Phase 10). Uploads are hidden in the UI until the first three are set.
# The storage account needs a CORS rule allowing PUT (header x-ms-blob-type) from the site origin.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=media
# Optional CDN/custom domain in front of the container
AZURE_STORAGE_PUBLIC_BASE=

# Optional: DNS servers for SRV lookups when the OS resolver fails (Windows), e.g. 1.1.1.1,8.8.8.8
DNS_SERVERS=
